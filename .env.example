NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: Resend alerts/reminders are disabled unless BOTH values are set.
# Gmail approval/rejection/revision emails do not depend on Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
FINANCE_NOTIFICATION_EMAIL=aea.college.org@student.ateneo.edu
ALLOWED_EMAIL_DOMAIN=student.ateneo.edu
# Production: use these instead of the local GDrive_key.json.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Optional domain-wide delegation, configured by your Workspace administrator.
GOOGLE_IMPERSONATED_USER=
CRON_SECRET=

# Finance request register (server-only configuration).
GOOGLE_REQUESTS_SPREADSHEET_ID=
GOOGLE_REQUESTS_SHEET_ID=0

# Organization Gmail OAuth (separate from Supabase login and Drive)
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:3000/api/google/gmail/callback
GOOGLE_GMAIL_REFRESH_TOKEN=
GOOGLE_GMAIL_SENDER=aea.college.org@student.ateneo.edu

# Optional local SQL bootstrap; never needed by the deployed web app.
DATABASE_URL=
INITIAL_CFO_EMAIL=
INITIAL_FISCAL_YEAR_LABEL=
INITIAL_FISCAL_YEAR_CODE=
INITIAL_FISCAL_YEAR_START=
INITIAL_FISCAL_YEAR_END=
