{
  "name": "aea-finance",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:ux": "node scripts/check-ux.mjs",
    "test:hydration": "node scripts/check-hydration.mjs",
    "check:integrations": "node --env-file=.env.local scripts/check-integrations.mjs",
    "db:setup": "node --env-file=.env.local scripts/setup-database.mjs",
    "check:security": "node --env-file-if-exists=.env.local scripts/check-client-secrets.mjs",
    "check:register": "node --conditions=react-server --import tsx --env-file=.env.local scripts/check-request-register.ts",
    "sync:register": "node --conditions=react-server --import tsx --env-file=.env.local scripts/sync-request-register.ts",
    "check:email": "node --env-file=.env.local scripts/check-email.mjs",
    "check:gmail": "node --conditions=react-server --import tsx --env-file=.env.local scripts/check-gmail.ts",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check src scripts tests docs README.md package.json eslint.config.mjs next.config.ts postcss.config.mjs tsconfig.json vercel.json",
    "check": "npm run lint && npm run typecheck && npm test",
    "check:deployment": "node --env-file-if-exists=.env.local scripts/check-deployment.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.0.0",
    "googleapis": "^160.0.0",
    "lucide-react": "^0.468.0",
    "next": "16.3.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "pg": "^8.23.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=22.13.0 <25"
  }
}
